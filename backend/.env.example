# Server Port
PORT=5000

# MongoDB URI (Optional: Leave blank to automatically use zero-config built-in in-memory MongoDB, or paste your MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/jobtracker?retryWrites=true&w=majority
MONGO_URI=

# JWT Secret Key for authenticating sessions
JWT_SECRET=super_secret_job_tracker_jwt_token_2026_dev_key
JWT_EXPIRE=30d

# Node Environment
NODE_ENV=development
